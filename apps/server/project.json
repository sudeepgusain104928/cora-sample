{
  "name": "@cora/server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/server/src",
  "targets": {
    "dev": {
      "command": "nodemon src/server.js",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "start": {
      "command": "node src/server.js",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "command": "vitest run",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "test:coverage": {
      "command": "vitest run --coverage",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "command": "node -e \"require('esbuild').build({entryPoints:['src/server.js'],bundle:true,platform:'node',format:'esm',outfile:'dist/server.js',packages:'external'})\"",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "outputs": ["{projectRoot}/dist"]
    }
  },
  "tags": ["type:app", "scope:server"]
}
