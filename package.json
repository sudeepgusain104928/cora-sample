{
  "name": "ank-cora-health",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"nx dev @cora/server\" \"nx dev @cora/web\"",
    "dev:server": "nx dev @cora/server",
    "dev:web": "nx dev @cora/web",
    "build": "nx build @cora/web",
    "build:all": "nx run-many -t build",
    "start": "nx start @cora/server",
    "test": "nx run-many -t test",
    "test:web": "nx test @cora/web",
    "test:server": "nx test @cora/server",
    "test:ui": "nx test @cora/ui",
    "storybook": "nx storybook @cora/ui",
    "lint": "nx run-many -t lint"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "esbuild": "0.28.0",
    "nx": "^22.7.5",
    "vite": "8.0.16"
  },
  "dependencies": {
    "@vitest/coverage-v8": "4.1.8",
    "vitest": "4.1.8"
  }
}
